@page "/add-movie"
@using Services

@inject NavigationManager NavigationManager
@inject MovieService MovieService

<h1>Add Movie</h1>

@if (alertVisible)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>@alertMessage</strong>
        <button type="button" class="btn-close" aria-label="Close" @onclick="ToggleAlertVisibility"></button>
    </div>
}

<EditForm Model="@movie" OnValidSubmit="OnSubmit">
    <DataAnnotationsValidator/>
    <div class="form-group">
        <label for="title">Títle</label>
        <input type="text" class="form-control" id="title" @bind="movie.Title"/>
        <ValidationMessage For="@(() => movie.Title)"/>
    </div>
    <div class="form-group">
        <label for="director">Director</label>
        <input type="text" id="director" @bind="movie.Director" class="form-control"/>
        <ValidationMessage For="@(() => movie.Director)"/>
    </div>
    <div class="form-group">
        <label for="releaseDate">Release Date</label>
        <input type="date" id="movie-releaseDate" name="movie-releaseDate" @bind="movie.ReleaseDate" class="form-control"/>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Save</button>
    <button type="button" class="btn btn-secondary mt-2" @onclick="OnCancel">Cancel</button>
</EditForm>

@code {
    private MovieDto movie = new MovieDto();
    private bool alertVisible;
    private string alertMessage = string.Empty;

    protected override void OnInitialized()
    {
        movie.ReleaseDate = DateTime.Now;
    }

    private void OnSubmit()
    {
        try
        {
            MovieService.AddMovie(movie);
            NavigationManager.NavigateTo("/get-movies");
        }
        catch (ArgumentException e)
        {
            alertVisible = true;
            alertMessage = e.Message;
        }
    }

    private void OnCancel()
    {
        NavigationManager.NavigateTo("/");
    }

    private void ToggleAlertVisibility()
    {
        alertVisible = !alertVisible;
    }

}
