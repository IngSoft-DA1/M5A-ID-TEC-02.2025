@page "/update-movie/{movieTitle}"
@using Domain
@using Services

@inject MovieService MovieServiceInjected
@inject NavigationManager NavigationManagerInjected

<h3>Update Movie</h3>

<EditForm Model="@movie" OnValidSubmit="OnSubmit">
    <div class="form-group">
        <label for="title">Títle</label>
        <input type="text" class="form-control" id="title" @bind="movie.Title" disabled/>
        <ValidationMessage For="@(() => movie.Title)"/>
    </div>
    <div class="form-group">
        <label for="director">Director</label>
        <input type="text" id="director" @bind="movie.Director" class="form-control"/>
        <ValidationMessage For="@(() => movie.Director)"/>
    </div>
    <div class="form-group">
        <label for="releaseDate">Release Date</label>
        <input type="date" id="movie-releaseDate" name="movie-releaseDate" @bind="movie.ReleaseDate" class="form-control"/>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Update Movie</button>
    <button type="button" class="btn btn-secondary mt-2" @onclick="OnCancel">Cancel</button>
</EditForm>

@code {

    public Movie? movie { get; set; }
    
    [Parameter]
    public string movieTitle { get; set; }

    protected override void OnInitialized()
    {
        movie = MovieServiceInjected.GetMovie(m => m.Title == movieTitle);
    }

    public void OnSubmit()
    {
        MovieServiceInjected.UpdateMovie(movie);
        NavigationManagerInjected.NavigateTo("/get-movies");
    }

    public void OnCancel()
    {
        NavigationManagerInjected.NavigateTo("/get-movies");
    }



}